   "cell_type": "raw",
   "source": [
    "{\n",
    "  \"cells\": [\n",
    "    {\n",
    "      \"cell_type\": \"markdown\",\n",
    "      \"metadata\": {},\n",
    "      \"source\": [\n",
    "        \"# V2 Models Comparison (Two Rounds)\\n\",\n",
    "        \"\\n\",\n",
    "        \"This notebook analyzes the latest RF/XGBoost/GCN comparison outputs.\\n\",\n",
    "        \"\\n\",\n",
    "        \"**Important note**: RF/XGBoost use the tabular `downstream_v2_informative` dataset, while GCN uses OPF JSON graphs built from `power_graph_builder` with labels derived from OPF objectives. They are not directly comparable unless samples, labels, and networks are aligned.\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"code\",\n",
    "      \"execution_count\": null,\n",
    "      \"metadata\": {},\n",
    "      \"outputs\": [],\n",
    "      \"source\": [\n",
    "        \"from pathlib import Path\\n\",\n",
    "        \"import json\\n\",\n",
    "        \"import numpy as np\\n\",\n",
    "        \"import pandas as pd\\n\",\n",
    "        \"import matplotlib.pyplot as plt\\n\",\n",
    "        \"import seaborn as sns\\n\",\n",
    "        \"\\n\",\n",
    "        \"sns.set_theme(style=\\\"whitegrid\\\")\\n\",\n",
    "        \"\\n\",\n",
    "        \"ROOT = Path('.')\\n\",\n",
    "        \"OUT = ROOT / 'analysis' / 'training'\\n\",\n",
    "        \"CLS_PATH = OUT / 'v2_models_lono_cls.csv'\\n\",\n",
    "        \"REG_PATH = OUT / 'v2_models_lono_reg.csv'\\n\",\n",
    "        \"META_PATH = OUT / 'v2_models_metadata.json'\\n\",\n",
    "        \"\\n\",\n",
    "        \"cls_df = pd.read_csv(CLS_PATH)\\n\",\n",
    "        \"reg_df = pd.read_csv(REG_PATH) if REG_PATH.exists() else pd.DataFrame()\\n\",\n",
    "        \"metadata = json.loads(META_PATH.read_text()) if META_PATH.exists() else {}\\n\",\n",
    "        \"\\n\",\n",
    "        \"display(cls_df.head())\\n\",\n",
    "        \"display(reg_df.head())\\n\",\n",
    "        \"metadata\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"markdown\",\n",
    "      \"metadata\": {},\n",
    "      \"source\": [\n",
    "        \"## Round 1: Quick diagnostic\\n\",\n",
    "        \"\\n\",\n",
    "        \"Focus:\\n\",\n",
    "        \"- check network coverage\\n\",\n",
    "        \"- check data sources and label notes\\n\",\n",
    "        \"- inspect per-network classification metrics\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"code\",\n",
    "      \"execution_count\": null,\n",
    "      \"metadata\": {},\n",
    "      \"outputs\": [],\n",
    "      \"source\": [\n",
    "        \"# Network coverage and counts\\n\",\n",
    "        \"tabular_counts = pd.Series(metadata.get('sample_counts', {}).get('tabular', {})).sort_index()\\n\",\n",
    "        \"gcn_counts = pd.Series(metadata.get('sample_counts', {}).get('gcn', {})).sort_index()\\n\",\n",
    "        \"\\n\",\n",
    "        \"display(pd.DataFrame({'tabular_samples': tabular_counts}))\\n\",\n",
    "        \"display(pd.DataFrame({'gcn_graphs': gcn_counts}))\\n\",\n",
    "        \"\\n\",\n",
    "        \"print('Label sources:', json.dumps(metadata.get('label_columns', {}), indent=2))\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"code\",\n",
    "      \"execution_count\": null,\n",
    "      \"metadata\": {},\n",
    "      \"outputs\": [],\n",
    "      \"source\": [\n",
    "        \"# Classification metrics by network and model\\n\",\n",
    "        \"metrics = ['auc', 'ap', 'f1', 'precision', 'recall']\\n\",\n",
    "        \"plot_df = cls_df.melt(id_vars=['seed', 'model', 'test_network'], value_vars=metrics, var_name='metric', value_name='value')\\n\",\n",
    "        \"\\n\",\n",
    "        \"g = sns.catplot(\\n\",\n",
    "        \"    data=plot_df,\\n\",\n",
    "        \"    x='test_network',\\n\",\n",
    "        \"    y='value',\\n\",\n",
    "        \"    hue='model',\\n\",\n",
    "        \"    col='metric',\\n\",\n",
    "        \"    kind='bar',\\n\",\n",
    "        \"    col_wrap=3,\\n\",\n",
    "        \"    height=3.2,\\n\",\n",
    "        \"    sharey=False\\n\",\n",
    "        \")\\n\",\n",
    "        \"g.set_titles('{col_name}')\\n\",\n",
    "        \"g.set_axis_labels('Network', 'Value')\\n\",\n",
    "        \"plt.tight_layout()\\n\",\n",
    "        \"plt.show()\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"code\",\n",
    "      \"execution_count\": null,\n",
    "      \"metadata\": {},\n",
    "      \"outputs\": [],\n",
    "      \"source\": [\n",
    "        \"# Threshold distribution by model\\n\",\n",
    "        \"if 'threshold' in cls_df.columns:\\n\",\n",
    "        \"    plt.figure(figsize=(6, 3))\\n\",\n",
    "        \"    sns.boxplot(data=cls_df, x='model', y='threshold')\\n\",\n",
    "        \"    plt.title('Threshold by model')\\n\",\n",
    "        \"    plt.tight_layout()\\n\",\n",
    "        \"    plt.show()\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"markdown\",\n",
    "      \"metadata\": {},\n",
    "      \"source\": [\n",
    "        \"## Round 2: Deeper comparison\\n\",\n",
    "        \"\\n\",\n",
    "        \"Focus:\\n\",\n",
    "        \"- regression performance across networks\\n\",\n",
    "        \"- mean/std summaries (multi-seed if available)\\n\",\n",
    "        \"- visualize per-model robustness\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"code\",\n",
    "      \"execution_count\": null,\n",
    "      \"metadata\": {},\n",
    "      \"outputs\": [],\n",
    "      \"source\": [\n",
    "        \"# Regression metrics by network and model (if available)\\n\",\n",
    "        \"if not reg_df.empty:\\n\",\n",
    "        \"    reg_metrics = ['mae', 'rmse', 'r2']\\n\",\n",
    "        \"    reg_plot_df = reg_df.melt(id_vars=['seed', 'model', 'test_network'], value_vars=reg_metrics, var_name='metric', value_name='value')\\n\",\n",
    "        \"    g = sns.catplot(\\n\",\n",
    "        \"        data=reg_plot_df,\\n\",\n",
    "        \"        x='test_network',\\n\",\n",
    "        \"        y='value',\\n\",\n",
    "        \"        hue='model',\\n\",\n",
    "        \"        col='metric',\\n\",\n",
    "        \"        kind='bar',\\n\",\n",
    "        \"        col_wrap=3,\\n\",\n",
    "        \"        height=3.2,\\n\",\n",
    "        \"        sharey=False\\n\",\n",
    "        \"    )\\n\",\n",
    "        \"    g.set_titles('{col_name}')\\n\",\n",
    "        \"    g.set_axis_labels('Network', 'Value')\\n\",\n",
    "        \"    plt.tight_layout()\\n\",\n",
    "        \"    plt.show()\\n\",\n",
    "        \"else:\\n\",\n",
    "        \"    print('No regression file found or it is empty.')\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"code\",\n",
    "      \"execution_count\": null,\n",
    "      \"metadata\": {},\n",
    "      \"outputs\": [],\n",
    "      \"source\": [\n",
    "        \"# Mean/std summary across seeds\\n\",\n",
    "        \"cls_summary = cls_df.groupby('model')[['auc', 'ap', 'f1', 'precision', 'recall']].agg(['mean', 'std'])\\n\",\n",
    "        \"display(cls_summary)\\n\",\n",
    "        \"\\n\",\n",
    "        \"if not reg_df.empty:\\n\",\n",
    "        \"    reg_summary = reg_df.groupby('model')[['mae', 'rmse', 'r2']].agg(['mean', 'std'])\\n\",\n",
    "        \"    display(reg_summary)\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"markdown\",\n",
    "      \"metadata\": {},\n",
    "      \"source\": [\n",
    "        \"## This round's thinking (summary)\\n\",\n",
    "        \"\\n\",\n",
    "        \"- **Separation of data sources**: RF/XGBoost operate on the downstream v2 tabular dataset, while GCN operates on OPF JSON graph data with labels derived from OPF objectives. Keep conclusions scoped to each data source until samples and labels are aligned.\\n\",\n",
    "        \"- **Calibration alignment**: The threshold sweep replicates the utility-based selection from `final_v2_threshold_sweep_fast.py`, making model thresholds comparable in terms of the same utility objective.\\n\",\n",
    "        \"- **Robustness checks**: Using multi-seed runs surfaces variance; report mean/std and avoid over-interpreting single-run results.\\n\",\n",
    "        \"- **Network effects**: LONO results are dominated by per-network distribution shifts. Treat outlier networks as diagnostic points rather than overfitting targets.\\n\",\n",
    "        \"- **Next step**: If you want strict model-to-model comparison, align GCN labels with the downstream dataset (dns_MW), or rebuild tabular features from the same OPF JSON sources.\"\n",
    "      ]\n",
    "    }\n",
    "  ],\n",
    "  \"metadata\": {\n",
    "    \"kernelspec\": {\n",
    "      \"display_name\": \"Python 3\",\n",
    "      \"language\": \"python\",\n",
    "      \"name\": \"python3\"\n",
    "    },\n",
    "    \"language_info\": {\n",
    "      \"name\": \"python\",\n",
    "      \"version\": \"3.10\"\n",
    "    }\n",
    "  },\n",
    "  \"nbformat\": 4,\n",
    "  \"nbformat_minor\": 5\n",
    "}\n"
